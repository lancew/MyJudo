{{> header}}

<main class="container">
	<h1>Login</h1>

	<form class="form-group" method="post">
		<label class="d-block form-group" for="login-username" >
			Username or Email
			<input id="login-username" autofocus class="form-control" name="login" placeholder="Username or Email" required>
		</label>
		<label class="d-block form-group" for="login-password" >
			Password
			<input id="login-password" class="form-control" name="password" placeholder="Password" required type="password">
		</label>
		<input class="btn btn-primary" type="submit" value="Login">
	</form>

	<p>
		Forgot your password?
		<a href="/password-reset">Request a password reset.</a>
	</p>
</main>

{{> footer}}
