
{{> header}}

<main class=container>
    <h1>Sessions: {{ total }}</h1>

    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col">Date
                <th scope="col">Training Type(s)
                <th scope="col">Techniques
        </thead>
        <tbody>
    {{#sessions}}
        <tr>
            <td>
                <a href="/user/{{ data.user_name }}/training-session/edit/{{ id }}">
                    {{ date }}
                </a>
            <td>{{ types }}
            <td>{{ techniques }}
    {{/sessions}}
        </tbody>
    </table>
</main>

{{> footer}}
