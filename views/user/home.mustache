{{> header}}

<main class="container">
    <h1>Welcome, {{ data.user_name }}</h1>

    <p>
        <a class="btn btn-primary" href="/user/{{ data.user_name }}/training-session/add">
            <i class="fa fa-plus" aria-hidden="true"></i>
            Add a Session
        </a>
        <a class="btn btn-outline-secondary" href="/user/{{ data.user_name }}/training-sessions">
            <i class="fa fa-list" aria-hidden="true"></i>
            View Sessions
        </a>
    </p>

    <h2>Statistics</h2>

    <table class="table">
        <thead>
            <tr>
                <th scope="col">Metric</th>
                <th scope="col">Value</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <th scope="row">
                    <a href="/user/{{ data.user_name }}/training-sessions">Sessions</a>
                </th>
                <td>
                    This month: {{ data.sessions_this_month }}<br>
                    Last month: {{ data.sessions_last_month }}<br>
                    This year:  {{ data.sessions_this_year  }}<br>
                    Last year:  {{ data.sessions_last_year  }}<br>
                    Total:      {{ data.sessions            }}
                </td>
            </tr>
            <tr>
                <th scope="row">Session Types</th>
                <td>
                    Kata:
                        {{ data.session_types.kata }}
                        {{^data.session_types.kata }}0{{/data.session_types.kata}}
                    <br>
                    Nage Komi:
                        {{ data.session_types.nage-komi }}
                    {{^data.session_types.nage-komi }}0{{/data.session_types.nage-komi}}
                    <br>
                    Ne Waza Randori:
                        {{ data.session_types.randori-ne-waza }}
                        {{^data.session_types.randori-ne-waza }}0{{/data.session_types.randori-ne-waza}}
                    <br>
                    Tachi Waza Randori:
                        {{ data.session_types.randori-tachi-waza }}
                        {{^data.session_types.randori-tachi-waza }}0{{/data.session_types.randori-tachi-waza}}
                    <br>
                    Uchi Komi:
                        {{ data.session_types.uchi-komi }}
                        {{^data.session_types.uchi-komi }}0{{/data.session_types.uchi-komi}}
                </td>
            </tr>
        </tbody>
    </table>
    <h2>Techniques ({{ waza.kanji }})</h2>

    <a href="#" id="toggle-charts" role="button" aria-expanded="false" aria-controls="chart-container">
        <i class="fa fa-chart-pie" aria-hidden="true"></i> Show/Hide charts
    </a>

    <div id="chart-container" class="container-fluid d-none">
        <div class="row">
            <div id="piechart_session_types" class="chart-box"></div>
        </div>
        <div class="row">
            <div id="piechart_month" class="chart-box"></div>
            <div id="piechart_last_month" class="chart-box"></div>
        </div>
        <div class="row">
            <div id="piechart_this_year" class="chart-box"></div>
            <div id="piechart_total" class="chart-box"></div>
        </div>
    </div>

    <script>
    document.getElementById('toggle-charts').addEventListener('click', (event) => {
        event.preventDefault();
        const container = document.getElementById('chart-container');
        const hidden = container.classList.toggle('d-none');
        event.currentTarget.setAttribute('aria-expanded', String(!hidden));
    });
    </script>

    <script>
    google.charts.load('current', {packages:['corechart']});

    google.charts.setOnLoadCallback( () => {
        const options = { is3D: true, pieSliceText: 'none' };

        new google.visualization.PieChart(
            document.getElementById('piechart_session_types'),
        ).draw(
            google.visualization.arrayToDataTable([
                ['Session Types', 'Total'],
                {{#sessions}}['{{ name }}', {{ number }}],{{/sessions}}
            ]),
            { ...options, title: 'Training Session Types' },
        );

        new google.visualization.PieChart(
            document.getElementById('piechart_month'),
        ).draw(
            google.visualization.arrayToDataTable([
                ['Techniques', 'Times Done'],
                {{#techniques}}
                    {{#techniques_this_month}}
                        ['{{ name }}', {{ techniques_this_month }}],
                    {{/techniques_this_month}}
                {{/techniques}}
            ]),
            { ...options, title: 'Techniques This Month' },
        );

        new google.visualization.PieChart(
            document.getElementById('piechart_last_month'),
        ).draw(
            google.visualization.arrayToDataTable([
                ['Techniques', 'Times Done'],
                {{#techniques}}
                    {{#techniques_last_month}}
                        ['{{ name }}', {{ techniques_last_month }}],
                    {{/techniques_last_month}}
                {{/techniques}}
            ]),
            { ...options, title: 'Techniques Last Month' },
        );

        new google.visualization.PieChart(
            document.getElementById('piechart_this_year'),
        ).draw(
            google.visualization.arrayToDataTable([
                ['Techniques', 'Times Done'],
                {{#techniques}}
                    {{#techniques_this_year}}
                        ['{{ name }}', {{ techniques_this_year }}],
                    {{/techniques_this_year}}
                {{/techniques}}
            ]),
            { ...options, title: 'Techniques This Year' },
        );

        new google.visualization.PieChart(
            document.getElementById('piechart_total'),
        ).draw(
            google.visualization.arrayToDataTable([
                ['Techniques', 'Times Done'],
                {{#techniques}}['{{ name }}', {{ number }}],{{/techniques}}
            ]),
            { ...options, title: 'Total Techniques' },
        );
    });
    </script>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                <th>Total (This Month)
                <th>Total (Last Month)
                <th>Total (This Year)
                <th>Total (All time)
        <tbody>
        {{#techniques}}
            <tr>
                <td>
                    {{ name }} ({{ kanji }})
                    <a href="//www.youtube.com/results?search_query={{ kanji }}"><i class="fab fa-youtube"></i></a>
                <td>{{ techniques_this_month }}
                <td>{{ techniques_last_month }}
                <td>{{ techniques_this_year  }}
                <td>{{ number }}
        {{/techniques}}
    </table>

          
</main>

{{> footer}}
